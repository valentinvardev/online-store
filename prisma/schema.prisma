generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

// ─── NextAuth ────────────────────────────────────────────────────────────────

model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? @db.Text
    access_token             String? @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? @db.Text
    session_state            String?
    refresh_token_expires_in Int?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String       @id @default(cuid())
    name          String?
    email         String?      @unique
    emailVerified DateTime?
    image         String?
    isAdmin       Boolean      @default(false)
    passwordHash  String?      // null para usuarios de Google/Resend
    phone         String?
    accounts      Account[]
    sessions      Session[]
    orders        Order[]
    enrollments   Enrollment[]
    bookings      Booking[]
    memberships   Membership[]
    comments      Comment[]
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ProductType {
    FISICO
    DIGITAL
    PERSONALIZADO
}

enum OrderStatus {
    PENDING
    PAID
    FAILED
    CANCELLED
}

enum ItemType {
    PRODUCT
    COURSE
    SERVICE
}

enum MembershipStatus {
    PENDING
    ACTIVE
    CANCELLED
    PAST_DUE
}

enum PostType {
    TEXT
    VIDEO
    AUDIO
    GALLERY
}

// ─── Catálogo ────────────────────────────────────────────────────────────────

model Product {
    id          String      @id @default(cuid())
    slug        String      @unique
    name        String
    description String
    descLong    String?     @db.Text
    price       Float
    priceOld    Float?
    type        ProductType
    badge       String?
    imageUrl    String?
    images      String[]
    videoUrl    String?
    fileUrl     String?
    stock       Int?
    features    String[]
    details     Json?
    gradient    String?
    active      Boolean     @default(true)
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
    orderItems  OrderItem[]
}

model Course {
    id            String         @id @default(cuid())
    slug          String         @unique
    name          String
    subtitle      String?
    description   String
    descLong      String?        @db.Text
    price         Float
    priceOld      Float?
    badge         String?
    level         String         @default("Todos los niveles")
    durationWeeks Int?
    duration      String?
    lessonsCount  Int?
    lessonsLabel  String?
    studentsLabel String?
    includes      String[]
    imageUrl      String?
    images        String[]
    videoUrl      String?
    active        Boolean        @default(true)
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    modules       CourseModule[]
    enrollments   Enrollment[]
    orderItems    OrderItem[]
}

model CourseModule {
    id          String         @id @default(cuid())
    courseId    String
    course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
    title       String
    order       Int
    attachments String[]
    lessons     CourseLesson[]
}

model CourseLesson {
    id          String       @id @default(cuid())
    moduleId    String
    module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
    title       String
    content     String?      @db.Text
    videoUrl    String?
    attachments String[]
    order       Int
    freePreview Boolean      @default(false)
    // Drip: null = disponible ya para socias; fecha futura = se libera ese día
    publishedAt DateTime?
}

model Service {
    id            String      @id @default(cuid())
    slug          String      @unique
    name          String
    subtitle      String?
    description   String      @db.Text
    price         Float
    priceLabel    String?
    badge         String?
    duration      Int
    durationLabel String?
    format        String      @default("Zoom")
    numero        String?
    contenido     String[]
    accentColor   String?
    bgColor       String?
    coverGradient String?
    imageUrl      String?
    images        String[]
    videoUrl      String?
    attachments   String[]
    active        Boolean     @default(true)
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt
    bookings      Booking[]
    orderItems    OrderItem[]
}

// ─── Órdenes ─────────────────────────────────────────────────────────────────

model Order {
    id          String      @id @default(cuid())
    userId      String?
    user        User?       @relation(fields: [userId], references: [id])
    email       String
    status      OrderStatus @default(PENDING)
    total       Float
    mpPaymentId String?
    mpPrefId    String?
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
    items       OrderItem[]
}

model OrderItem {
    id        String   @id @default(cuid())
    orderId   String
    order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
    itemType  ItemType
    productId String?
    product   Product? @relation(fields: [productId], references: [id])
    courseId  String?
    course    Course?  @relation(fields: [courseId], references: [id])
    serviceId String?
    service   Service? @relation(fields: [serviceId], references: [id])
    quantity  Int      @default(1)
    price     Float
    name      String
}

// ─── Acceso ───────────────────────────────────────────────────────────────────

model Enrollment {
    id        String   @id @default(cuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    courseId  String
    course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@unique([userId, courseId])
}

model Booking {
    id        String   @id @default(cuid())
    userId    String?
    user      User?    @relation(fields: [userId], references: [id])
    serviceId String
    service   Service  @relation(fields: [serviceId], references: [id])
    email     String
    date      DateTime
    notes     String?
    createdAt DateTime @default(now())
}

// ─── Círculo (membresías + posts) ────────────────────────────────────────────

model MembershipTier {
    id          String   @id @default(cuid())
    slug        String   @unique
    name        String
    subtitle    String?
    description String?  @db.Text
    price       Float
    priceYearly Float?
    currency    String   @default("USD")
    interval    String   @default("month")
    color       String?
    perks       String[]
    sortOrder   Int      @default(0)
    active      Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    memberships Membership[]
    posts       Post[]
}

model Membership {
    id               String           @id @default(cuid())
    userId           String
    user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    tierId           String
    tier             MembershipTier   @relation(fields: [tierId], references: [id])
    status           MembershipStatus @default(PENDING)
    mpSubscriptionId String?          @unique
    startedAt        DateTime         @default(now())
    nextBillingAt    DateTime?
    cancelledAt      DateTime?
    createdAt        DateTime         @default(now())
    updatedAt        DateTime         @updatedAt

    @@unique([userId, tierId])
}

model Post {
    id             String          @id @default(cuid())
    slug           String          @unique
    title          String?         // null = mensaje rápido (estilo estado), sin título
    excerpt        String?
    content        String          @db.Text
    contentType    PostType        @default(TEXT)
    coverImageUrl  String?
    videoUrl       String?
    audioUrl       String?
    images         String[]
    attachments    String[]
    requiredTierId String?
    requiredTier   MembershipTier? @relation(fields: [requiredTierId], references: [id])
    published      Boolean         @default(false)
    publishedAt    DateTime?
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    comments       Comment[]

    @@index([published, publishedAt])
}

model Comment {
    id        String    @id @default(cuid())
    body      String    @db.Text
    userId    String
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    postId    String
    post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
    parentId  String?
    parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
    replies   Comment[] @relation("CommentReplies")
    createdAt DateTime  @default(now())

    @@index([postId, createdAt])
    @@index([parentId])
}

// ─── Newsletter ──────────────────────────────────────────────────────────────

model Subscriber {
    id           String    @id @default(cuid())
    email        String    @unique
    active       Boolean   @default(true)
    source       String?
    createdAt    DateTime  @default(now())
    unsubscribed DateTime?
}
